<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Transparent Falling Hearts Background</title>
  <style>
    /* Reset & Base Layout */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* body {
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #0f0c20 0%, #1a102f 50%, #2b0f2e 100%);
      color: #ffffff;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
    } */
body {
    background-color: #1a102f;
}
    /* Main Card Content (Demo foreground element) */
    .content-card {
      position: relative;
      z-index: 10;
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 3rem 2rem;
      text-align: center;
      max-width: 450px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .content-card h1 {
      font-size: 2.2rem;
      margin-bottom: 0.8rem;
      letter-spacing: 0.5px;
    }

    .content-card p {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.6;
    }

    /* Rain Background Container */
    .heart-rain-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none; /* Mouse clicks pass through to content */
      overflow: hidden;
      z-index: 1;
    }

    /* Base Heart Shape using CSS Pseudoelements */
    .heart {
      position: absolute;
      top: -50px;
      left: calc(var(--x) * 1vw);
      width: 18px;
      height: 18px;
      background-color: #b90861;
      transform: rotate(-45deg) scale(var(--size, 1));
      box-shadow: 0 0 12px rgba(255, 192, 203, var(--glow, 0.3));
      animation: fall var(--speed, 4s) linear infinite;
      animation-delay: var(--delay, 0s);
      will-change: transform;
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      background-color: inherit;
      border-radius: 50%;
    }

    .heart::before {
      top: -9px;
      left: 0;
    }

    .heart::after {
      left: 9px;
      top: 0;
    }

    /* Fall and Sway Motion Keyframes */
    @keyframes fall {
      0% {
        top: -10%;
        transform: translateX(0) rotate(-45deg) scale(var(--size, 1));
      }
      50% {
        transform: translateX(30px) rotate(-30deg) scale(var(--size, 1));
      }
      100% {
        top: 105vh;
        transform: translateX(-20px) rotate(-60deg) scale(var(--size, 1));
      }
    }
  </style>
</head>
<body>

  <!-- Demo Content (Foreground) -->
  <main class="content-card">
    <h1>Heart Rain</h1>
    <p>Pure CSS animated transparent hearts background layer.</p>
  </main>

  <!-- Animated Hearts Background Container -->
  <div class="heart-rain-container" aria-hidden="true">
    <!-- Inline CSS Variables govern horizontal positioning (--x), scale (--size), falling speed (--speed), start offset (--delay), and transparency (--opacity) -->
    <div class="heart" style="--x: 4;  --size: 0.8; --speed: 4.2s; --delay: 0s;   --opacity: 0.35;"></div>
    <div class="heart" style="--x: 12; --size: 1.4; --speed: 5.5s; --delay: 1.2s; --opacity: 0.2;"></div>
    <div class="heart" style="--x: 20; --size: 0.6; --speed: 3.8s; --delay: 0.5s; --opacity: 0.5;"></div>
    <div class="heart" style="--x: 28; --size: 1.8; --speed: 6.0s; --delay: 2.1s; --opacity: 0.25;"></div>
    <div class="heart" style="--x: 36; --size: 1.0; --speed: 4.5s; --delay: 0.8s; --opacity: 0.4;"></div>
    <div class="heart" style="--x: 44; --size: 1.2; --speed: 5.0s; --delay: 1.8s; --opacity: 0.3;"></div>
    <div class="heart" style="--x: 52; --size: 0.7; --speed: 3.5s; --delay: 0.2s; --opacity: 0.6;"></div>
    <div class="heart" style="--x: 60; --size: 1.5; --speed: 5.8s; --delay: 1.5s; --opacity: 0.25;"></div>
    <div class="heart" style="--x: 68; --size: 0.9; --speed: 4.1s; --delay: 0.9s; --opacity: 0.45;"></div>
    <div class="heart" style="--x: 76; --size: 1.3; --speed: 6.2s; --delay: 2.5s; --opacity: 0.3;"></div>
    <div class="heart" style="--x: 84; --size: 0.8; --speed: 3.9s; --delay: 0.4s; --opacity: 0.5;"></div>
    <div class="heart" style="--x: 92; --size: 1.6; --speed: 5.2s; --delay: 1.1s; --opacity: 0.2;"></div>
  </div>

</body>
</html>